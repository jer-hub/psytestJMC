# PsytestJMC environment template
# Copy to .env and adjust. Never commit real secrets.
#
#   cp .env.example .env

# --- Docker Compose / PostgreSQL ---
DB_NAME=psytest_db
DB_USER=postgres
DB_PASSWORD=123
DB_HOST=localhost
DB_PORT=5432
DB_PUBLISH_PORT=5432
WEB_PORT=8000

# --- Django site ---
DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web,psytest-web
SITE_DOMAIN=localhost:8000
SITE_NAME=psytestJMC
SEED_DATA=1

# Bootstrap superuser (Compose entrypoint)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@localhost
DJANGO_SUPERUSER_PASSWORD=admin123

# --- Email ---
# Local default (dev settings): console backend → messages print to logs.
# For Gmail SMTP, create an App Password and set:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Social auth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_SECRET_KEY=
FB_CLIENT_ID=
FB_SECRET_KEY=

# --- Vercel / managed Postgres (optional) ---
# PGDATABASE=
# PGUSER=
# PGPASSWORD=
# PGHOST=
# PGPORT=
# DJANGO_SETTINGS_MODULE=psytests.settings.vercel
